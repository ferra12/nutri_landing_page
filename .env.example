# Copia questo file in .env e compila i valori prima di avviare in locale.
# NON committare .env nel repository.

# SMTP — Gmail: abilita "App Password" nelle impostazioni Google
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tua.email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# Indirizzo che riceve i messaggi dal form di contatto
